# ==============================================================================
# KINGSMAN LUXURY SNEAKERS — PRODUCTION ENVIRONMENT CONFIGURATION
# Configure these variables in your Vercel Project Settings or local .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Base canonical URL for the storefront
SITE_URL="https://kingsmanszn.com"
NODE_ENV="production"
PORT=3000

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL DATABASE (SERVER-ONLY SECRETS)
# In production, Supabase is the mandatory single source of truth.
# NEVER prefix SUPABASE_SERVICE_ROLE_KEY with VITE_ or expose to the browser!
# ------------------------------------------------------------------------------
# Your Supabase project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL="https://your-project.supabase.co"

# Supabase Service Role Secret Key (Bypasses Row Level Security for backend APIs)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# ------------------------------------------------------------------------------
# 3. ADMIN PORTAL SECURITY & SESSION SIGNING (SERVER-ONLY SECRETS)
# Used to authenticate executive admin login and sign 12h httpOnly cookies.
# ------------------------------------------------------------------------------
# Strong master password for the executive admin portal
ADMIN_PASSWORD="your-strong-production-admin-password"

# Cryptographic random secret key used to HMAC-SHA256 sign session cookies
SESSION_SECRET="your-cryptographic-64-char-random-secret"

# ------------------------------------------------------------------------------
# 4. ORDER NOTIFICATIONS & GOOGLE SHEETS INTEGRATION (SERVER-ONLY)
# ------------------------------------------------------------------------------
# Store owner email for new order alerts and administrative reports
OWNER_EMAIL="kingsmanszn@gmail.com"

# Google Apps Script Webhook URL for real-time order sync to Google Sheets
GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/your-google-script-id/exec"

# ------------------------------------------------------------------------------
# 5. CLIENT-SIDE MARKETING, ANALYTICS & CONVERSION TRACKING (VITE_ PREFIXED)
# Safe for bundling into the client application.
# ------------------------------------------------------------------------------
# Google Analytics 4 Measurement ID
VITE_GA4_ID="G-XXXXXXXXXX"

# Google Tag Manager Container ID
VITE_GTM_ID="GTM-XXXXXXX"

# Meta (Facebook) Pixel ID for conversion tracking
VITE_META_PIXEL_ID="123456789012345"

# Google Ads Conversion Tracking ID
VITE_GOOGLE_ADS_ID="AW-XXXXXXXXXX"
